--- a/os_dep/linux/os_intfs.c
+++ b/os_dep/linux/os_intfs.c
@@ -2126,6 +2126,11 @@ int rtw_os_ndev_register(_adapter *adapter, const char *name)
 
 	if (rtnl_lock_needed)
 		ret = (register_netdev(ndev) == 0) ? _SUCCESS : _FAIL;
+#if (RTW_CFG80211_VERSION >= KERNEL_VERSION(5, 12, 0)) && defined(CONFIG_IOCTL_CFG80211)
+	/* called from cfg80211 ops with the wiphy lock held */
+	else if (ndev->ieee80211_ptr)
+		ret = (cfg80211_register_netdevice(ndev) == 0) ? _SUCCESS : _FAIL;
+#endif
 	else
 		ret = (register_netdevice(ndev) == 0) ? _SUCCESS : _FAIL;
 
@@ -2175,6 +2180,11 @@ void rtw_os_ndev_unregister(_adapter *adapter)
 
 		if (rtnl_lock_needed)
 			unregister_netdev(netdev);
+#if (RTW_CFG80211_VERSION >= KERNEL_VERSION(5, 12, 0)) && defined(CONFIG_IOCTL_CFG80211)
+		/* called from cfg80211 ops with the wiphy lock held */
+		else if (netdev->ieee80211_ptr)
+			cfg80211_unregister_netdevice(netdev);
+#endif
 		else
 			unregister_netdevice(netdev);
 	}
