# Seed .config для OpenWrt v25.12.5 + HOMEd Gateway Pico.
# Использование (внутри build-25.12.5.sh): feeds update/install -> cp seed .config -> make defconfig.
# make defconfig сам допишет зависимости и DEVICE_PACKAGES из mt76x8.mk.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_homed_gateway-pico=y

# LuCI + HTTPS (uhttpd, px5g)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# WiFi AP (как в 22.03.5; если wolfssl-варианта нет в 25.12 — заменить на wpad-basic-mbedtls)
CONFIG_PACKAGE_wpad-basic-wolfssl=y

# MQTT-брокер для HOMEd
CONFIG_PACKAGE_mosquitto-nossl=y

# Утилиты (как в старой прошивке)
CONFIG_PACKAGE_picocom=y
CONFIG_PACKAGE_mc=y
CONFIG_PACKAGE_curl=y

# Железо Pico: SD-слот (в 25.12 вместо kmod-sdhci-mt7620), USB-A, env tools
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_uboot-envtools=y
