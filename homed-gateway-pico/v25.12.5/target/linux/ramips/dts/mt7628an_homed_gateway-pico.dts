#include "mt7628an.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "homed,gateway-pico", "mediatek,mt7628an-soc";
	model = "HOMEd Gateway Pico";

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	chosen {
		bootargs = "console=ttyS0,57600";
	};

	leds {
		compatible = "gpio-leds";

		led_status: status {
			label = "amber:status";
			gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
		};

		led_speed: speed {
			label = "amber:act";
			gpios = <&gpio 42 GPIO_ACTIVE_LOW>;
		};

		led_link: link {
			label = "green:link";
			gpios = <&gpio 43 GPIO_ACTIVE_LOW>;
		};

		led_wled: wled {
			label = "amber:wled";
			gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};
	};

	gpio-export {
		compatible = "gpio-export";

		reset {
			gpio-export,name = "zb:reset";
			gpio-export,output = <1>;
			gpios = <&gpio 5 GPIO_ACTIVE_HIGH>;
		};

		boot {
			gpio-export,name = "zb:boot";
			gpio-export,output = <1>;
			gpios = <&gpio 19 GPIO_ACTIVE_HIGH>;
		};
	};
};

&state_default {
	gpio {
		groups = "gpio";
		function = "gpio";
	};

	perst {
		groups = "perst";
		function = "gpio";
	};

	refclk {
		groups = "refclk";
		function = "gpio";
	};

	i2s {
		groups = "i2s";
		function = "gpio";
	};

	spis {
		groups = "spis";
		function = "gpio";
	};

	wled_kn {
		groups = "wled_kn";
		function = "gpio";
	};

	wled_an {
		groups = "wled_an";
		function = "gpio";
	};

	wdt {
		groups = "wdt";
		function = "gpio";
	};

	pwm0 {
		groups = "pwm0";
		function = "gpio";
	};

	pwm1 {
		groups = "pwm1";
		function = "gpio";
	};

	p0led_an {
		groups = "p0led_an";
		function = "gpio";
	};

	p1led_an {
		groups = "p1led_an";
		function = "gpio";
	};
};

&spi0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins>, <&spi_cs1_pins>;

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;
		broken-flash-reset;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x400>;
					};

					macaddr_factory_28: macaddr@28 {
						reg = <0x28 0x6>;
					};
				};
			};

			firmware: partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0x1fb0000>;
			};
		};
	};

	spidev@1 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "linux,spidev";
		reg = <1>;
		spi-max-frequency = <40000000>;
	};
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&ethernet {
	nvmem-cells = <&macaddr_factory_28>;
	nvmem-cell-names = "mac-address";
};

&pinctrl {
	ephy-digital;

	sdxc_iot_mode: sdxc_iot_mode {
		esd {
			groups = "esd";
			function = "iot";
		};

		sdxc {
			groups = "sdmode";
			function = "sdxc";
		};
	};
};

&sdhci {
	status = "okay";

	pinctrl-0 = <&sdxc_iot_mode>;
	pinctrl-1 = <&sdxc_iot_mode>;
};

&wmac {
	status = "okay";

	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
};
