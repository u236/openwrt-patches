+	pinctrl-0 = <&mod3_pins>;
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+	cts-override;
+	rts-gpios = <&pio 8 15 GPIO_ACTIVE_HIGH>;
+	linux,rs485-enabled-at-boot-time;
+	status = "okay";
+};
+
+&uart5 {
+	compatible = "allwinner,sun50i-h616-uart", "snps,dw-apb-uart";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mod4_pins>;
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+	cts-override;
+	rts-gpios = <&pio 3 10 GPIO_ACTIVE_HIGH>;
+	linux,rs485-enabled-at-boot-time;
+	status = "okay";
+};
+
+&usbotg {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbphy {
+	usb1_vbus-supply = <&reg_wifi>;
+	usb3_vbus-supply = <&reg_usb_vbus>;
+	status = "okay";
+};
