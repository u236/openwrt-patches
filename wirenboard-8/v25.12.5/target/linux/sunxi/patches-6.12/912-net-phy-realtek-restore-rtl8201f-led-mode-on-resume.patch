--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -355,6 +355,22 @@ static int rtl8201_config_intr(struct phy_device *phydev)
 	return err;
 }
 
+/* ~10 ms after leaving power down the PHY restores the default LED mode
+ * kept in the IER register
+ */
+static int rtl8201_resume(struct phy_device *phydev)
+{
+	int ret;
+
+	ret = genphy_resume(phydev);
+	if (ret < 0)
+		return ret;
+
+	msleep(20);
+
+	return rtl8201_config_intr(phydev);
+}
+
