. /lib/functions.sh

# Фиксированная сеть по требованию: 192.168.200.12/24, шлюз .1
# Имя файла 99 — выполняется после стандартного board_config (02_network),
# поэтому переопределяет lan с eth0/br-lan на статику.
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.200.12'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.gateway='192.168.200.1'
uci -q delete network.lan.dns
uci add_list network.lan.dns='192.168.200.1'
uci add_list network.lan.dns='8.8.8.8'
uci -q delete network.lan.ip6assign
uci commit network

exit 0
